{
  "name": "videotranscriber",
  "version": "1.0.0",
  "description": "Transcripción local de videos con Whisper.cpp",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.js",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "check:env": "node scripts/check-environment.js"
  },
  "keywords": [
    "electron",
    "transcripcion",
    "whisper",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2"
  }
}
